{
  "rules": {
    "shops": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'd6JhdOvQt0TYmnEwhhRTF1yRDxa2'",
      ".indexOn": ["id"],

      "$shopId": {
        "userReviews": {
          ".write": true,
          "$reviewId": {
            ".write": true
          }
        },
        "userRatings": {
          ".read": true,
          ".write": true
        },
        "comments": {
          ".write": true,
          "$commentId": {
            ".write": true
          }
        },
        "likes": {
          ".read": true,
          ".write": true
        }
      }
    },
    "shopViews": {
      ".read": true,
      "$shopId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
      }
    },
    "events": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'd6JhdOvQt0TYmnEwhhRTF1yRDxa2'",
      ".indexOn": ["id", "dateTime"]
    },
    "requests": {
      ".read": "auth != null && auth.uid === 'd6JhdOvQt0TYmnEwhhRTF1yRDxa2'",
      ".indexOn": ["timestamp"],
      "$requestId": {
        ".write": "!data.exists() || (auth != null && auth.uid === 'd6JhdOvQt0TYmnEwhhRTF1yRDxa2')"
      }
    },
    "appTexts": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'd6JhdOvQt0TYmnEwhhRTF1yRDxa2'"
    },
    "adminUsers": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'd6JhdOvQt0TYmnEwhhRTF1yRDxa2'"
    }
  }
}
