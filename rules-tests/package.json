{
  "name": "rules-tests",
  "description": "Exhaustive positive/negative coverage of firestore.rules and database.rules.json against the Firebase emulators.",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulators": "firebase emulators:exec --project demo-rules-test --only firestore,database,storage \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^12.4.0",
    "vitest": "^4.1.11"
  }
}
