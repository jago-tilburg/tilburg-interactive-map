rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Visitor account profiles. A visitor can only read/write their own
    // document — server (Cloud Functions with admin creds) bypasses these
    // rules entirely, so this is purely about client access.
    match /visitors/{uid} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email', 'displayName', 'createdAt'])
        // Bounds chosen generously (well above any real content) so a
        // legitimate signup is never rejected — same philosophy as
        // businessEvents' create rule below.
        && request.resource.data.email is string && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200
        // marketingConsent itself is set later via update (the onboarding
        // step, PLAN-INLOGGEN.md §8) — update stays intentionally
        // unconstrained like businesses/{uid}'s (see input-validation
        // history), but a create that happens to include it up front still
        // gets typed-checked.
        && (!('marketingConsent' in request.resource.data)
          || request.resource.data.marketingConsent is bool);
    }

    // Business account profiles. Same owner-only shape as visitors/{uid}.
    match /businesses/{uid} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['businessName', 'email', 'city', 'createdAt'])
        && request.resource.data.businessName is string && request.resource.data.businessName.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() <= 320
        && request.resource.data.city is string && request.resource.data.city.size() <= 100;
    }

    // Admin membership list. Never client-readable or client-writable — only
    // used internally by other rules' exists()/get() checks (see the events
    // module) and seeded/managed via IAM/Admin SDK, not through the app.
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Business-submitted events (distinct from the legacy RTDB `events`
    // node, which stays untouched). `status` and `paid` are the two fields
    // this whole module exists to make server-authoritative — neither can
    // ever be set by a direct client write, only by Cloud Functions (Admin
    // SDK bypasses these rules entirely): stripeWebhook sets both together
    // once Stripe confirms payment (publishing the event directly, no
    // separate admin approval step), and suspendEvent/blockEvent/restoreEvent
    // move status reactively after the fact. This also means significant
    // content (title/dates/location) locks the moment an event is paid, not
    // just while "approved" — see the update rule below.
    match /businessEvents/{eventId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && request.auth.uid == resource.data.ownerId)
        || (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paid == false
        && request.resource.data.keys().hasAll([
          'title', 'category', 'description', 'startDate', 'endDate',
          'startTime', 'endTime', 'lat', 'lng', 'address', 'ownerId',
          'city', 'status', 'paid', 'createdAt'
        ])
        // Field-presence via hasAll() alone says nothing about the actual
        // values — without this, lat/lng could be non-numeric, title could
        // be an object, and there was no length bound at all (found via a
        // pen-test). Bounds chosen generously (well above any real content)
        // specifically to never reject a legitimate submission.
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.category is string
        && request.resource.data.description is string && request.resource.data.description.size() <= 5000
        && request.resource.data.startDate is string && request.resource.data.endDate is string
        && request.resource.data.startTime is string && request.resource.data.endTime is string
        && request.resource.data.address is string && request.resource.data.address.size() <= 500
        && request.resource.data.city is string && request.resource.data.city.size() <= 100
        && request.resource.data.lat is number && request.resource.data.lng is number
        // umbrellaEventId is optional, but when present must reference a
        // real umbrella — otherwise a business could tag their event under
        // a nonexistent or unaffiliated festival with no admin involvement
        // at all (found via a pen-test; the UI badge just trusts this id).
        && (!('umbrellaEventId' in request.resource.data)
          || request.resource.data.umbrellaEventId == null
          || exists(/databases/$(database)/documents/umbrellaEvents/$(request.resource.data.umbrellaEventId)));
        // multiDay, dailyTimes are optional extra fields — no hasAll()
        // requirement for them, same pattern as the required set above but
        // not mandatory on every event.

      allow update: if (request.auth != null
        && request.auth.uid == resource.data.ownerId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.paid == resource.data.paid
        && request.resource.data.status == resource.data.status
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        // A paid event's "significant" fields (title/dates/location) become
        // immutable via direct write — once a business has committed money
        // to a listing, its headline facts can't be silently rewritten
        // client-side (found via a pen-test, originally gated on
        // status=='approved' with a pull-back-to-'pending' escape hatch;
        // that escape hatch is gone now that there's no more admin
        // re-review to pull back into — paid is the more correct gate
        // anyway, since it also closes a gap the old rule had: a paid event
        // that gets suspended/blocked, status no longer 'approved', used to
        // reopen significant-field editing). Non-significant fields
        // (description/prices/photoUrl/websiteUrl/etc.) can still be
        // edited freely regardless, matching the app's actual, intentional
        // policy — this only closes the gap between that policy and what
        // the rule enforces.
        && (!resource.data.paid
          || (request.resource.data.title == resource.data.title
            && request.resource.data.startDate == resource.data.startDate
            && request.resource.data.endDate == resource.data.endDate
            && request.resource.data.lat == resource.data.lat
            && request.resource.data.lng == resource.data.lng))
        // Same existence check as create — an edit can also introduce or
        // change umbrellaEventId.
        && (!('umbrellaEventId' in request.resource.data)
          || request.resource.data.umbrellaEventId == null
          || request.resource.data.umbrellaEventId == resource.data.umbrellaEventId
          || exists(/databases/$(database)/documents/umbrellaEvents/$(request.resource.data.umbrellaEventId))))
        // Public engagement counters (views/interest/clicks/shares) — open
        // to anyone, including unauthenticated visitors, on an approved
        // event, mirroring the RTDB shops' openly-writable likes/views.
        // Every other field must stay byte-for-byte identical, so this
        // branch can never be used to smuggle a status/paid/ownerId change
        // past the owner-only branch above.
        || (resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'interest', 'clicks', 'shares']));

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Umbrella events ("Groot Tilburgs event", e.g. a festival) — admin-
    // managed grouping containers that individual businessEvents can
    // optionally tag themselves under via umbrellaEventId. Public read
    // (shown on the map/detail pages), admin-only write. Not money- or
    // approval-sensitive, so a direct admin-gated rule is fine here — no
    // Cloud Function needed, unlike businessEvents' status/paid.
    match /umbrellaEvents/{umbrellaId} {
      allow read: if true;

      // create/update need request.resource.data (the incoming document),
      // which doesn't exist on a delete — kept as a separate allow delete
      // below rather than one combined `allow write`, or adding these
      // checks to a combined rule would make every delete evaluate
      // request.resource.data against a null request.resource and fail.
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.keys().hasAll(['title', 'description', 'color', 'startDate', 'endDate'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.description is string && request.resource.data.description.size() <= 5000
        && request.resource.data.color is string && request.resource.data.color.size() <= 50
        && request.resource.data.startDate is string && request.resource.data.endDate is string
        // city is required on create (resource == null identifies create in
        // a combined create/update rule) but only type/length-checked on
        // update if present — existing pre-city umbrellaEvents docs from
        // before this field existed must stay editable without a backfill
        // (GO-LIVE-CHECKLIST.md §0, decided 2026-09-02: types+writes only,
        // no backfill in this pass).
        && (resource == null ? request.resource.data.keys().hasAll(['city']) : true)
        && (!('city' in request.resource.data)
          || (request.resource.data.city is string && request.resource.data.city.size() <= 100));

      allow delete: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // User-filed reports against a shop/event/comment/review (and, once
    // built, a shop/event photo). Open to anyone, including unauthenticated
    // visitors, matching the app's anonymous-interaction model elsewhere —
    // reporterId is a self-asserted uid or device-local anon id, not
    // verified against request.auth, same trust model shop likes/comments
    // already use. Read/resolve restricted to admins.
    match /reports/{reportId} {
      allow read: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));

      // Covers both filing a new report and a reporter re-filing on the
      // same content (same deterministic doc id — see reports.ts) to
      // reopen it. Always lands as 'open'; a direct write can never set
      // resolvedAt/resolvedBy itself, only the admin branch below can.
      allow create, update: if request.resource.data.keys().hasAll(
          ['contentType', 'contentId', 'reporterId', 'reason', 'createdAt', 'status']
        )
        && request.resource.data.contentType in ['shop', 'businessEvent', 'comment', 'review', 'shopPhoto', 'eventPhoto']
        && request.resource.data.reason in ['spam', 'offensive', 'incorrect_info', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.reporterId is string && request.resource.data.reporterId.size() <= 200
        && request.resource.data.contentId is string && request.resource.data.contentId.size() <= 200
        && (!('parentId' in request.resource.data)
          || (request.resource.data.parentId is string && request.resource.data.parentId.size() <= 200))
        && (!('details' in request.resource.data)
          || (request.resource.data.details is string && request.resource.data.details.size() <= 1000))
        && !('resolvedAt' in request.resource.data)
        && !('resolvedBy' in request.resource.data);

      // Admin resolve/dismiss — the only path that can move status away
      // from 'open', and only these three fields may change.
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.status in ['resolved', 'dismissed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy']);

      allow delete: if false;
    }

    // Everything else is closed by default until its module is built.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
